{
  "site_name": "Angrut",
  "base_url": "https://angrut.com",
  "allowed_domains": [
    "angrut.com",
    "www.angrut.com"
  ],
  "listing_urls": [
    "https://angrut.com/"
  ],
  "article_link_selectors": [
    "a[href*='/article/']"
  ],
  "article_link_pattern": "https?://(?:www\\.)?angrut\\.com/article/\\d+/?$",
  "article_link_exclude_patterns": [],
  "remove_selectors": [],
  "request": {
    "timeout_seconds": 30,
    "delay_seconds": 0.15,
    "verify_ssl": true,
    "respect_robots_txt": false,
    "user_agent": "Mozilla/5.0",
    "headers": {
      "Accept": "application/json, text/plain, */*"
    }
  },
  "api": {
    "listing": {
      "url": "https://angrut.com/wp-json/wp/v2/posts",
      "params": {
        "per_page": 20,
        "page": "{page}",
        "_embed": 1
      },
      "items_path": ".",
      "link_field": "link",
      "default_pages": 1
    },
    "article": {
      "url_template": "https://angrut.com/wp-json/wp/v2/posts/{id}?_embed=1",
      "id_pattern": "/article/(\\d+)/?$"
    },
    "json_fields": {
      "title": {
        "mode": "first",
        "extractors": [
          {
            "path": "title.rendered"
          }
        ]
      },
      "summary": {
        "mode": "first",
        "extractors": [
          {
            "path": "excerpt.rendered"
          }
        ]
      },
      "published_at": {
        "mode": "first",
        "extractors": [
          {
            "path": "date_gmt"
          },
          {
            "path": "date"
          }
        ]
      },
      "author": {
        "mode": "first",
        "extractors": [
          {
            "path": "_embedded.author.name"
          }
        ]
      },
      "category": {
        "mode": "list",
        "extractors": [
          {
            "path": "_embedded.wp:term.0.name"
          }
        ]
      },
      "content": {
        "mode": "join",
        "separator": "\n\n",
        "extractors": [
          {
            "path": "content.rendered"
          }
        ]
      },
      "image": {
        "mode": "first",
        "extractors": [
          {
            "path": "_embedded.wp:featuredmedia.0.source_url"
          },
          {
            "path": "jetpack_featured_media_url"
          }
        ]
      }
    }
  },
  "fields": {
    "title": {},
    "summary": {},
    "published_at": {},
    "author": {},
    "category": {},
    "content": {},
    "image": {}
  }
}
