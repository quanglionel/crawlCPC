{
  "site_name": "Cwcicambodia",
  "base_url": "https://cwcicambodia.net",
  "allowed_domains": [
    "cwcicambodia.net",
    "www.cwcicambodia.net"
  ],
  "listing_urls": [
    "https://cwcicambodia.net/"
  ],
  "article_link_selectors": [
    "h2 a[href]",
    "article a[href]"
  ],
  "article_link_pattern": "https?://(?:www\\.)?cwcicambodia\\.net/\\d{4}/\\d{2}/\\d{2}/[^/?#]+/?$",
  "article_link_exclude_patterns": [
    "#respond$"
  ],
  "remove_selectors": [
    "script",
    "style",
    "noscript",
    "iframe",
    "form",
    "nav",
    "header",
    "footer",
    ".sharedaddy",
    ".jp-relatedposts",
    ".comments-area",
    ".widget-area",
    ".post-navigation"
  ],
  "request": {
    "timeout_seconds": 30,
    "delay_seconds": 0.2,
    "verify_ssl": true,
    "respect_robots_txt": false,
    "user_agent": "Mozilla/5.0"
  },
  "fields": {
    "title": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:title']",
          "attr": "content"
        },
        {
          "selector": "h1.entry-title"
        },
        {
          "selector": "h1"
        },
        {
          "selector": "title"
        }
      ]
    },
    "summary": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:description']",
          "attr": "content"
        },
        {
          "selector": "meta[name='description']",
          "attr": "content"
        },
        {
          "selector": ".entry-summary"
        }
      ]
    },
    "published_at": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='article:published_time']",
          "attr": "content"
        },
        {
          "selector": "time[datetime]",
          "attr": "datetime"
        },
        {
          "selector": "time"
        },
        {
          "selector": ".posted-on"
        }
      ]
    },
    "author": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='author']",
          "attr": "content"
        },
        {
          "selector": ".byline"
        },
        {
          "selector": ".author"
        }
      ]
    },
    "content": {
      "mode": "join",
      "separator": "\n\n",
      "extractors": [
        {
          "selector": ".entry-content p"
        },
        {
          "selector": "article p"
        }
      ]
    },
    "image": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:image']",
          "attr": "content"
        },
        {
          "selector": ".entry-content img[src]",
          "attr": "src"
        },
        {
          "selector": "article img[src]",
          "attr": "src"
        }
      ]
    }
  }
}
