{
  "site_name": "The Diplomat",
  "base_url": "https://thediplomat.com",
  "allowed_domains": [
    "thediplomat.com",
    "www.thediplomat.com"
  ],
  "listing_urls": [
    "https://thediplomat.com/feed/"
  ],
  "article_link_selectors": [],
  "article_link_regexes": [
    "<link>(https?://(?:www\\.)?thediplomat\\.com/\\d{4}/\\d{2}/[^<]+/)</link>"
  ],
  "article_link_pattern": "https?://(?:www\\.)?thediplomat\\.com/\\d{4}/\\d{2}/[^?#]+/?$",
  "article_link_exclude_patterns": [],
  "remove_selectors": [
    "script",
    "style",
    "noscript",
    "iframe",
    "form",
    "nav",
    "header",
    "footer"
  ],
  "request": {
    "timeout_seconds": 20,
    "delay_seconds": 0.1,
    "verify_ssl": true,
    "respect_robots_txt": false,
    "user_agent": "Mozilla/5.0",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
    }
  },
  "fields": {
    "title": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:title']",
          "attr": "content"
        },
        {
          "selector": "h1"
        },
        {
          "selector": "title"
        }
      ]
    },
    "summary": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:description']",
          "attr": "content"
        },
        {
          "selector": "meta[name='description']",
          "attr": "content"
        }
      ]
    },
    "published_at": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='article:published_time']",
          "attr": "content"
        },
        {
          "selector": "time[datetime]",
          "attr": "datetime"
        }
      ]
    },
    "author": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='author']",
          "attr": "content"
        },
        {
          "selector": "a[rel='author']"
        }
      ]
    },
    "content": {
      "mode": "join",
      "separator": "\n\n",
      "extractors": [
        {
          "selector": "article p"
        },
        {
          "selector": "main p"
        }
      ]
    },
    "image": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:image']",
          "attr": "content"
        },
        {
          "selector": "article img[src]",
          "attr": "src"
        }
      ]
    }
  }
}

