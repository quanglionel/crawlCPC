{
  "site_name": "MFAIC",
  "base_url": "https://www.mfaic.gov.kh",
  "allowed_domains": [
    "www.mfaic.gov.kh",
    "mfaic.gov.kh"
  ],
  "listing_urls": [
    "https://www.mfaic.gov.kh/Media/News"
  ],
  "article_link_selectors": [
    "a[href]"
  ],
  "article_link_pattern": "^https?://(?:www\\.)?mfaic\\.gov\\.kh/(?:en/)?[Mm]edia/[Vv]iew/.+",
  "article_link_exclude_patterns": [
    "\\.(?:css|gif|ico|jpe?g|js|png|svg|webp)(?:[?#]|$)",
    "(?:facebook|instagram|linkedin|telegram|tiktok|twitter|x|youtube)\\.com"
  ],
  "fields": {
    "title": {
      "mode": "first",
      "extractors": [
        {
          "selector": ".viewpost-title"
        },
        {
          "selector": "title"
        }
      ]
    },
    "summary": {
      "mode": "first",
      "extractors": [
        {
          "selector": ".viewpost-content p"
        },
        {
          "selector": ".viewpost-content"
        }
      ]
    },
    "published_at": {
      "mode": "first",
      "extractors": [
        {
          "selector": ".viewpost-date"
        },
        {
          "selector": "$url",
          "regex": "20\\d{2}-\\d{2}-\\d{2}"
        }
      ]
    },
    "author": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='author']",
          "attr": "content"
        }
      ]
    },
    "content": {
      "mode": "join",
      "separator": "\n\n",
      "extractors": [
        {
          "selector": ".viewpost-content p"
        },
        {
          "selector": ".viewpost-content"
        }
      ]
    },
    "images": {
      "mode": "list",
      "extractors": [
        {
          "selector": ".viewpost img[src]",
          "attr": "src"
        },
        {
          "selector": ".viewpost-image img[src]",
          "attr": "src"
        }
      ]
    }
  },
  "remove_selectors": [
    "script",
    "style",
    "noscript",
    "iframe",
    "form",
    "nav",
    "header",
    "footer",
    ".morepost",
    ".viewpost-otherposts"
  ],
  "request": {
    "timeout_seconds": 20,
    "delay_seconds": 0.2,
    "respect_robots_txt": false,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
      "Accept-Language": "en-US,en;q=0.9,km;q=0.8",
      "Upgrade-Insecure-Requests": "1"
    }
  }
}
