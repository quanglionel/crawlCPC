{
  "site_name": "freshnews-kh",
  "base_url": "https://freshnews.com.kh",
  "allowed_domains": [
    "freshnews.com.kh"
  ],
  "listing_urls": [
    "https://freshnews.com.kh/"
  ],
  "article_link_selectors": [
    "main a[href]"
  ],
  "article_link_pattern": "https://freshnews\\.com\\.kh/[^/]+/\\d+-\\d{4}-\\d{2}-\\d{2}-\\d{2}-\\d{2}-\\d{2}$",
  "article_link_exclude_patterns": [],
  "remove_selectors": [
    ".content .mb-5",
    ".content iframe",
    ".content script",
    ".content style"
  ],
  "request": {
    "timeout_seconds": 30,
    "delay_seconds": 0.2,
    "verify_ssl": true,
    "respect_robots_txt": false,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
  },
  "fields": {
    "title": {
      "mode": "first",
      "extractors": [
        {
          "selector": "h4.headline"
        },
        {
          "selector": "meta[property='og:title']",
          "attr": "content"
        }
      ]
    },
    "summary": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='description']",
          "attr": "content"
        },
        {
          "selector": "meta[property='og:description']",
          "attr": "content"
        }
      ]
    },
    "published_at": {
      "mode": "first",
      "extractors": [
        {
          "selector": ".content > p.list-title"
        }
      ]
    },
    "author": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='author']",
          "attr": "content"
        }
      ]
    },
    "category": {
      "mode": "list",
      "extractors": [
        {
          "selector": ".breadcrumb a"
        }
      ]
    },
    "content": {
      "mode": "join",
      "separator": "\n\n",
      "extractors": [
        {
          "selector": ".content span > p"
        }
      ]
    },
    "image": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:image']",
          "attr": "content"
        }
      ]
    }
  }
}
