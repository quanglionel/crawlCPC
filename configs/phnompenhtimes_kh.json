{
  "site_name": "Phnom Penh Times",
  "base_url": "https://phnompenhtimes.com.kh",
  "allowed_domains": [
    "phnompenhtimes.com.kh",
    "www.phnompenhtimes.com.kh"
  ],
  "listing_urls": [
    "https://phnompenhtimes.com.kh/"
  ],
  "article_link_selectors": [
    "a[href*='/article/']"
  ],
  "article_link_pattern": "https?://(?:www\\.)?phnompenhtimes\\.com\\.kh/article/[^/?#]+$",
  "article_link_exclude_patterns": [],
  "remove_selectors": [],
  "request": {
    "timeout_seconds": 30,
    "delay_seconds": 0.15,
    "verify_ssl": true,
    "respect_robots_txt": false,
    "user_agent": "Mozilla/5.0",
    "headers": {
      "Accept": "application/json, text/plain, */*",
      "Content-Type": "application/json",
      "Origin": "https://phnompenhtimes.com.kh",
      "Referer": "https://phnompenhtimes.com.kh/"
    }
  },
  "api": {
    "listing": {
      "method": "POST",
      "url": "https://firestore.googleapis.com/v1/projects/phnompenhtimes-b8834/databases/(default)/documents:runQuery",
      "params": {
        "key": "AIzaSyCk2Bba2dtEQgb7CCKMPiVEofQzUpN6_RM"
      },
      "json": {
        "structuredQuery": {
          "from": [
            {
              "collectionId": "content"
            }
          ],
          "where": {
            "fieldFilter": {
              "field": {
                "fieldPath": "status.key"
              },
              "op": "EQUAL",
              "value": {
                "integerValue": "1"
              }
            }
          },
          "orderBy": [
            {
              "field": {
                "fieldPath": "page_key"
              },
              "direction": "DESCENDING"
            }
          ],
          "limit": 20
        }
      },
      "items_path": ".",
      "link_template": "https://phnompenhtimes.com.kh/article/{document.fields.key.stringValue}",
      "default_pages": 1
    },
    "article": {
      "url_template": "https://firestore.googleapis.com/v1/projects/phnompenhtimes-b8834/databases/(default)/documents/content/{id}?key=AIzaSyCk2Bba2dtEQgb7CCKMPiVEofQzUpN6_RM",
      "id_pattern": "/article/([^/?#]+)$"
    },
    "json_fields": {
      "title": {
        "mode": "first",
        "extractors": [
          {
            "path": "fields.name.stringValue"
          }
        ]
      },
      "summary": {
        "mode": "first",
        "extractors": [
          {
            "path": "fields.reference.stringValue"
          },
          {
            "path": "fields.editname.stringValue"
          }
        ]
      },
      "published_at": {
        "mode": "first",
        "extractors": [
          {
            "path": "fields.create_date.timestampValue"
          },
          {
            "path": "fields.update_date.timestampValue"
          }
        ]
      },
      "author": {
        "mode": "first",
        "extractors": [
          {
            "path": "fields.create_by.mapValue.fields.name.stringValue"
          },
          {
            "path": "fields.update_by.mapValue.fields.name.stringValue"
          }
        ]
      },
      "category": {
        "mode": "list",
        "extractors": [
          {
            "path": "fields.category.arrayValue.values.mapValue.fields.name.stringValue"
          }
        ]
      },
      "content": {
        "mode": "join",
        "separator": "\n\n",
        "extractors": [
          {
            "path": "fields.editname.stringValue"
          }
        ]
      },
      "image": {
        "mode": "first",
        "extractors": [
          {
            "path": "fields.fileurl.stringValue"
          }
        ]
      }
    }
  },
  "fields": {
    "title": {},
    "summary": {},
    "published_at": {},
    "author": {},
    "category": {},
    "content": {},
    "image": {}
  }
}
