{
  "site_name": "Kampuchea Thmey",
  "base_url": "https://www.kampucheathmey.com",
  "allowed_domains": [
    "www.kampucheathmey.com"
  ],
  "listing_urls": [
    "https://www.kampucheathmey.com/"
  ],
  "article_link_selectors": [
    "a[href]"
  ],
  "article_link_pattern": "^https?://www\\.kampucheathmey\\.com/(?!category/|author/|tag/|page/)[a-z0-9-]+/\\d+/?$",
  "article_link_exclude_patterns": [
    "/(?:category|author|tag|page|feed|wp-admin|wp-content|wp-json)(?:/|$)",
    "\\.(?:css|gif|ico|jpe?g|js|png|svg|webp)(?:[?#]|$)",
    "(?:facebook|instagram|linkedin|telegram|tiktok|twitter|x|youtube)\\.com"
  ],
  "fields": {
    "title": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:title']",
          "attr": "content"
        },
        {
          "selector": "h1.mvp-post-title"
        },
        {
          "selector": "h1.entry-title"
        },
        {
          "selector": "h1"
        }
      ]
    },
    "summary": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='og:description']",
          "attr": "content"
        },
        {
          "selector": "meta[name='description']",
          "attr": "content"
        }
      ]
    },
    "published_at": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[property='article:published_time']",
          "attr": "content"
        },
        {
          "selector": "time[datetime]",
          "attr": "datetime"
        },
        {
          "selector": "time"
        },
        {
          "selector": ".mvp-post-date.updated"
        }
      ]
    },
    "author": {
      "mode": "first",
      "extractors": [
        {
          "selector": "meta[name='author']",
          "attr": "content"
        },
        {
          "selector": ".author-name"
        },
        {
          "selector": ".byline"
        }
      ]
    },
    "content": {
      "mode": "join",
      "separator": "\n\n",
      "extractors": [
        {
          "selector": "#mvp-content-main p"
        }
      ]
    },
    "images": {
      "mode": "list",
      "extractors": [
        {
          "selector": "meta[property='og:image']",
          "attr": "content"
        },
        {
          "selector": "#mvp-content-main img[src]",
          "attr": "src"
        }
      ]
    }
  },
  "remove_selectors": [
    "script",
    "style",
    "noscript",
    "iframe",
    "form",
    "nav",
    "footer",
    ".mvp-related-posts",
    ".mvp-related-posts-list",
    ".mvp-post-soc-wrap",
    ".mvp-post-tags",
    ".comments",
    ".advertisement",
    ".ads"
  ],
  "request": {
    "timeout_seconds": 20,
    "delay_seconds": 0.2,
    "respect_robots_txt": false,
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "Accept-Language": "km,en-US;q=0.9,en;q=0.8,vi;q=0.7"
    }
  }
}
